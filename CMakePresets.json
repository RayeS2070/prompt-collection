{
  "version": 9,
  "cmakeMinimumRequired": {
    "major": 3,
    "minor": 30,
    "patch": 0
  },
  "configurePresets": [
    {
      "name": "base",
      "hidden": true,
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/${presetName}",
      "installDir": "${sourceDir}/install/${presetName}",
      "cacheVariables": {
        "CMAKE_EXPORT_COMPILE_COMMANDS": true,
        "CPM_SOURCE_CACHE": "$env{HOME}/.cache/CPM"
      }
    },
    {
      "name": "debug",
      "hidden": true,
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug"
      }
    },
    {
      "name": "release",
      "hidden": true,
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release"
      }
    },
    {
      "name": "asan",
      "hidden": true,
      "description": "AddressSanitizer + UBSan. The environment reaches build and test runs made through presets, not a binary started by hand.",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "PROMPT_COLLECTION_SANITIZE": true
      },
      "environment": {
        "ASAN_OPTIONS": "detect_leaks=1",
        "LSAN_OPTIONS": "verbosity=1:log_threads=1"
      }
    },
    {
      "name": "linux",
      "hidden": true,
      "inherits": [
        "base"
      ],
      "condition": {
        "type": "equals",
        "lhs": "${hostSystemName}",
        "rhs": "Linux"
      }
    },
    {
      "name": "native_gcc",
      "hidden": true,
      "inherits": [
        "base"
      ],
      "description": "GCC on Linux, or MinGW GCC in an MSYS2 shell on Windows.",
      "cacheVariables": {
        "CMAKE_C_COMPILER": "gcc",
        "CMAKE_CXX_COMPILER": "g++"
      },
      "condition": {
        "type": "inList",
        "string": "${hostSystemName}",
        "list": [
          "Linux",
          "Windows"
        ]
      }
    },
    {
      "name": "clang",
      "hidden": true,
      "inherits": [
        "linux"
      ],
      "cacheVariables": {
        "CMAKE_C_COMPILER": "clang",
        "CMAKE_CXX_COMPILER": "clang++",
        "CMAKE_LINKER_TYPE": "LLD"
      }
    },
    {
      "name": "mingw",
      "hidden": true,
      "inherits": [
        "linux"
      ],
      "description": "Windows from Linux with the MinGW-w64 cross compiler; the tests run under wine.",
      "cacheVariables": {
        "CMAKE_SYSTEM_NAME": "Windows",
        "CMAKE_SYSTEM_PROCESSOR": "x86_64",
        "CMAKE_C_COMPILER": "x86_64-w64-mingw32-gcc",
        "CMAKE_CXX_COMPILER": "x86_64-w64-mingw32-g++",
        "CMAKE_RC_COMPILER": "x86_64-w64-mingw32-windres",
        "CMAKE_FIND_ROOT_PATH": "/usr/x86_64-w64-mingw32",
        "CMAKE_FIND_ROOT_PATH_MODE_PROGRAM": "NEVER",
        "CMAKE_FIND_ROOT_PATH_MODE_LIBRARY": "ONLY",
        "CMAKE_FIND_ROOT_PATH_MODE_INCLUDE": "ONLY",
        "CMAKE_CROSSCOMPILING_EMULATOR": "wine"
      },
      "environment": {
        "WINEDEBUG": "-all"
      }
    },
    {
      "name": "macos",
      "hidden": true,
      "inherits": [
        "base"
      ],
      "description": "Clang and libc++ from Homebrew LLVM: Apple Clang lags behind in C++26. Set LLVM_ROOT to $(brew --prefix llvm).",
      "cacheVariables": {
        "CMAKE_C_COMPILER": "$env{LLVM_ROOT}/bin/clang",
        "CMAKE_CXX_COMPILER": "$env{LLVM_ROOT}/bin/clang++",
        "CMAKE_EXE_LINKER_FLAGS": "-L$env{LLVM_ROOT}/lib/c++ -L$env{LLVM_ROOT}/lib/unwind -lunwind -Wl,-rpath,$env{LLVM_ROOT}/lib/c++"
      },
      "condition": {
        "type": "equals",
        "lhs": "${hostSystemName}",
        "rhs": "Darwin"
      }
    },
    {
      "name": "gcc_debug",
      "displayName": "gcc-debug",
      "inherits": [
        "native_gcc",
        "debug"
      ]
    },
    {
      "name": "gcc_release",
      "displayName": "gcc-release",
      "inherits": [
        "native_gcc",
        "release"
      ]
    },
    {
      "name": "clang_debug",
      "displayName": "clang-debug",
      "inherits": [
        "clang",
        "debug"
      ]
    },
    {
      "name": "clang_release",
      "displayName": "clang-release",
      "inherits": [
        "clang",
        "release"
      ]
    },
    {
      "name": "clang_asan",
      "displayName": "clang-asan",
      "inherits": [
        "clang",
        "asan"
      ]
    },
    {
      "name": "mingw_debug",
      "displayName": "mingw-debug (Windows from Linux)",
      "inherits": [
        "mingw",
        "debug"
      ]
    },
    {
      "name": "mingw_release",
      "displayName": "mingw-release (Windows from Linux)",
      "inherits": [
        "mingw",
        "release"
      ]
    },
    {
      "name": "macos_debug",
      "displayName": "macos-debug",
      "inherits": [
        "macos",
        "debug"
      ]
    },
    {
      "name": "macos_release",
      "displayName": "macos-release",
      "inherits": [
        "macos",
        "release"
      ]
    }
  ],
  "buildPresets": [
    {
      "name": "gcc_debug",
      "configurePreset": "gcc_debug"
    },
    {
      "name": "gcc_release",
      "configurePreset": "gcc_release"
    },
    {
      "name": "clang_debug",
      "configurePreset": "clang_debug"
    },
    {
      "name": "clang_release",
      "configurePreset": "clang_release"
    },
    {
      "name": "clang_asan",
      "configurePreset": "clang_asan"
    },
    {
      "name": "mingw_debug",
      "configurePreset": "mingw_debug"
    },
    {
      "name": "mingw_release",
      "configurePreset": "mingw_release"
    },
    {
      "name": "macos_debug",
      "configurePreset": "macos_debug"
    },
    {
      "name": "macos_release",
      "configurePreset": "macos_release"
    }
  ],
  "testPresets": [
    {
      "name": "base",
      "hidden": true,
      "output": {
        "outputOnFailure": true
      }
    },
    {
      "name": "gcc_debug",
      "configurePreset": "gcc_debug",
      "inherits": [
        "base"
      ]
    },
    {
      "name": "gcc_release",
      "configurePreset": "gcc_release",
      "inherits": [
        "base"
      ]
    },
    {
      "name": "clang_debug",
      "configurePreset": "clang_debug",
      "inherits": [
        "base"
      ]
    },
    {
      "name": "clang_release",
      "configurePreset": "clang_release",
      "inherits": [
        "base"
      ]
    },
    {
      "name": "clang_asan",
      "configurePreset": "clang_asan",
      "inherits": [
        "base"
      ]
    },
    {
      "name": "mingw_debug",
      "configurePreset": "mingw_debug",
      "inherits": [
        "base"
      ]
    },
    {
      "name": "mingw_release",
      "configurePreset": "mingw_release",
      "inherits": [
        "base"
      ]
    },
    {
      "name": "macos_debug",
      "configurePreset": "macos_debug",
      "inherits": [
        "base"
      ]
    },
    {
      "name": "macos_release",
      "configurePreset": "macos_release",
      "inherits": [
        "base"
      ]
    }
  ]
}
